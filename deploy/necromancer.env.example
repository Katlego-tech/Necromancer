# Copy to /etc/necromancer/necromancer.env (root:root, mode 600). NEVER commit the real file.
# deploy/set_access_code.sh fills in NECRO_ACCESS_CODE; do not put the code in any file in the repo.
NECRO_ACCESS_CODE=
# Use the EC2 instance role (IMDSv2). No AWS CLI and no long-lived keys on the box.
NECRO_CREDENTIALS_SOURCE=imds
AWS_REGION=us-east-1
# Cost limits (code defaults: 180 / 60 / 20 / 200). Set the caps from the measured price (T7.5).
NECRO_MAX_SESSION_SECONDS=180
NECRO_IDLE_SECONDS=60
NECRO_DAILY_CAP=20
NECRO_TOTAL_CAP=200
NECRO_USAGE_LOG=/opt/necromancer/var/usage.jsonl
NECRO_CAPS_FILE=/opt/necromancer/var/caps.json
# Shown on the paused page when live voice is off. Fill in once the demo video exists.
NECRO_DEMO_VIDEO_URL=
