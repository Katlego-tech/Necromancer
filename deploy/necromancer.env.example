# Copy to /etc/necromancer/necromancer.env (root:root, mode 600). NEVER commit the real file.
# deploy/set_access_code.sh fills in NECRO_ACCESS_CODE; do not put the code in any file in the repo.
NECRO_ACCESS_CODE=
# Judges' code (deploy/set_access_code.sh --judge). At least 12 characters and different from the
# public code, or the server refuses to start. Put it ONLY in the Devpost form.
NECRO_JUDGE_CODE=
# Use the EC2 instance role (IMDSv2). No AWS CLI and no long-lived keys on the box.
NECRO_CREDENTIALS_SOURCE=imds
AWS_REGION=us-east-1
# Cost limits (code defaults: 180 / 60 / 20 / 200). Set the caps from the measured price (T7.5).
NECRO_MAX_SESSION_SECONDS=180
NECRO_IDLE_SECONDS=60
NECRO_DAILY_CAP=20
NECRO_TOTAL_CAP=200
# Judge allowance (code defaults: 300 / 90 / 30 / 150). Public caps never block judges. Placeholders until T7.5.
NECRO_JUDGE_MAX_SESSION_SECONDS=300
NECRO_JUDGE_IDLE_SECONDS=90
NECRO_JUDGE_DAILY_CAP=30
NECRO_JUDGE_TOTAL_CAP=150
# The judge code stops working after this moment (ISO 8601 with offset). Judging ends 29 Jan 2027, 1:00 pm PT.
NECRO_JUDGE_EXPIRES=2027-01-29T23:59:59-08:00
# Emergency switch: create disable-judge or disable-public in this directory to cut that code off at once.
NECRO_CONTROL_DIR=/opt/necromancer/var/control
# Caddy on this host is the only way in, so trust its X-Forwarded-For for wrong-code rate limiting.
# Without this every visitor shares one lockout bucket. Turn it OFF if the app is ever exposed directly.
NECRO_TRUST_PROXY=1
NECRO_USAGE_LOG=/opt/necromancer/var/usage.jsonl
NECRO_CAPS_FILE=/opt/necromancer/var/caps.json
# Shown on the paused page when live voice is off. Fill in once the demo video exists.
NECRO_DEMO_VIDEO_URL=
