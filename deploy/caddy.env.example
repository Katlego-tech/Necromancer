# Copy to /etc/necromancer/caddy.env. The public hostname Caddy gets a certificate for.
# Your own domain (an A record pointing at the Elastic IP), or a free name that embeds the IP,
# for example 203-0-113-10.sslip.io (replace with the real Elastic IP, dots become dashes).
NECRO_SITE=necro.example.com
